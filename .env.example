# Banco de dados (Postgres). Em produção use a URL com pooler (PgBouncer/Supavisor)
DATABASE_URL="postgresql://quack:quack@localhost:5432/quackpass"
# Conexão direta (sem pooler) usada só pelas migrations
DIRECT_URL="postgresql://quack:quack@localhost:5432/quackpass"

# URL pública do site (usada em links e no retorno do 3DS do débito)
APP_URL="http://localhost:3000"

# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-grande"

# Taxa da plataforma por ingresso
PLATFORM_FEE_PERCENT="10"
PLATFORM_FEE_MIN_CENTS="300"

# Tempo (minutos) que um pedido segura os ingressos aguardando pagamento
ORDER_RESERVATION_MINUTES="15"

# Gateway: "mock" (desenvolvimento) ou "pagarme"
PAYMENT_PROVIDER="mock"
PAGARME_SECRET_KEY=""
PAGARME_PUBLIC_KEY=""
# recipient_id da PLATAFORMA (sua conta), que recebe a taxa no split
PAGARME_PLATFORM_RECIPIENT_ID=""
# Usuário/senha configurados no webhook do painel Pagar.me (Basic Auth)
PAGARME_WEBHOOK_USER=""
PAGARME_WEBHOOK_PASSWORD=""

# Protege a rota de cron que expira pedidos (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="troque-isto"
